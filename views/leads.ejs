<%- include('partials/header', {
  title: 'Leads',
  activePage: 'leads'
}) %>

<section class="page-heading">
  <div>
    <p class="eyebrow">Lead inbox</p>
    <h1>Leads</h1>
    <p class="page-heading__description">
      Review contact requests from every lead form in one place.
    </p>
  </div>

  <a class="secondary-button" href="<%= pagination.jsonUrl %>">View JSON</a>
</section>

<section class="summary-grid" aria-label="Lead summary">
  <article class="summary-card">
    <span class="summary-card__label">Total leads</span>
    <strong class="summary-card__value"><%= total.toLocaleString('en-IN') %></strong>
  </article>
  <article class="summary-card">
    <span class="summary-card__label">On this page</span>
    <strong class="summary-card__value"><%= count.toLocaleString('en-IN') %></strong>
  </article>
  <article class="summary-card">
    <span class="summary-card__label">Current page</span>
    <strong class="summary-card__value"><%= page.toLocaleString('en-IN') %></strong>
  </article>
</section>

<section class="data-panel" aria-labelledby="leads-table-title">
  <div class="data-panel__header">
    <div>
      <h2 id="leads-table-title">Latest submissions</h2>
      <p>Newest leads appear first.</p>
    </div>
  </div>

  <div class="table-scroll">
    <table class="data-table leads-table">
      <caption class="visually-hidden">Lead submissions</caption>
      <thead>
        <tr>
          <th scope="col">Received</th>
          <th scope="col">Contact</th>
          <th scope="col">Type</th>
          <th scope="col">Status</th>
          <th scope="col">Source</th>
          <th scope="col"><span class="visually-hidden">Details</span></th>
        </tr>
      </thead>
      <tbody>
        <% if (leads.length === 0) { %>
          <tr class="empty-row">
            <td colspan="6">
              <div class="empty-state">
                <span class="empty-state__mark" aria-hidden="true">0</span>
                <strong>No leads found</strong>
                <p>New lead form submissions will appear here.</p>
              </div>
            </td>
          </tr>
        <% } %>

        <% for (const lead of leads) { %>
          <tr>
            <td data-label="Received">
              <time datetime="<%= toIsoDate(lead.created_at) %>"><%= formatAdminDate(lead.created_at) %></time>
              <span class="record-id">ID <%= lead.id %></span>
            </td>
            <td data-label="Contact">
              <strong class="primary-value"><%= lead.name %></strong>
              <a class="contact-link" href="mailto:<%= lead.email %>"><%= lead.email %></a>
              <a class="contact-link" href="tel:<%= lead.phone %>"><%= lead.phone %></a>
            </td>
            <td data-label="Type">
              <span class="badge badge--blue"><%= lead.lead_type %></span>
            </td>
            <td data-label="Status">
              <strong class="secondary-value"><%= lead.stage || 'Not set' %></strong>
              <span class="muted-value"><%= lead.responsible || 'Unassigned' %></span>
            </td>
            <td data-label="Source">
              <strong class="secondary-value"><%= lead.page_name || '—' %></strong>
              <span class="muted-value text-break"><%= lead.form_name || lead.source || 'No source details' %></span>
            </td>
            <td data-label="Details" class="details-cell">
              <details class="row-details">
                <summary>View details</summary>
                <div class="details-popover">
                  <dl class="detail-grid">
                    <div class="detail-grid__wide">
                      <dt>Message</dt>
                      <dd class="preserve-lines"><%= lead.message || '—' %></dd>
                    </div>
                    <div>
                      <dt>Page</dt>
                      <dd><%= lead.page_name || '—' %></dd>
                    </div>
                    <div>
                      <dt>Form</dt>
                      <dd><%= lead.form_name || '—' %></dd>
                    </div>
                    <div class="detail-grid__wide">
                      <dt>Source</dt>
                      <dd class="text-break"><%= lead.source || '—' %></dd>
                    </div>
                    <div>
                      <dt>UTM source</dt>
                      <dd><%= lead.utm_source || '—' %></dd>
                    </div>
                    <div>
                      <dt>UTM medium</dt>
                      <dd><%= lead.utm_medium || '—' %></dd>
                    </div>
                    <div>
                      <dt>UTM campaign</dt>
                      <dd><%= lead.utm_campaign || '—' %></dd>
                    </div>
                  </dl>
                </div>
              </details>
            </td>
          </tr>
        <% } %>
      </tbody>
    </table>
  </div>

  <%- include('partials/pagination', { pagination }) %>
</section>

<%- include('partials/footer') %>
