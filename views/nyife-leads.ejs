<%- include('partials/header', {
  title: 'Nyife leads',
  activePage: 'nyife-leads'
}) %>

<section class="page-heading">
  <div>
    <p class="eyebrow eyebrow--nyife">Nyife</p>
    <h1>Nyife leads</h1>
    <p class="page-heading__description">
      Review demo and signup requests submitted through Nyife landing pages.
    </p>
  </div>

  <a class="secondary-button" href="<%= pagination.jsonUrl %>">View JSON</a>
</section>

<section class="summary-grid" aria-label="Nyife lead summary">
  <article class="summary-card">
    <span class="summary-card__label">Total leads</span>
    <strong class="summary-card__value"><%= total.toLocaleString('en-IN') %></strong>
  </article>
  <article class="summary-card">
    <span class="summary-card__label">On this page</span>
    <strong class="summary-card__value"><%= count.toLocaleString('en-IN') %></strong>
  </article>
  <article class="summary-card">
    <span class="summary-card__label">Current page</span>
    <strong class="summary-card__value"><%= page.toLocaleString('en-IN') %></strong>
  </article>
</section>

<section class="data-panel" aria-labelledby="nyife-leads-table-title">
  <div class="data-panel__header">
    <div>
      <h2 id="nyife-leads-table-title">Latest submissions</h2>
      <p>Newest Nyife leads appear first.</p>
    </div>
  </div>

  <div class="table-scroll">
    <table class="data-table nyife-leads-table">
      <caption class="visually-hidden">Nyife lead submissions</caption>
      <thead>
        <tr>
          <th scope="col">Received</th>
          <th scope="col">Contact</th>
          <th scope="col">Company</th>
          <th scope="col">Plan</th>
          <th scope="col">Demo</th>
          <th scope="col"><span class="visually-hidden">Details</span></th>
        </tr>
      </thead>
      <tbody>
        <% if (leads.length === 0) { %>
          <tr class="empty-row">
            <td colspan="6">
              <div class="empty-state">
                <span class="empty-state__mark empty-state__mark--nyife" aria-hidden="true">0</span>
                <strong>No Nyife leads found</strong>
                <p>New Nyife signup submissions will appear here.</p>
              </div>
            </td>
          </tr>
        <% } %>

        <% for (const lead of leads) { %>
          <tr>
            <td data-label="Received">
              <time datetime="<%= toIsoDate(lead.created_at) %>"><%= formatAdminDate(lead.created_at) %></time>
              <span class="record-id">ID <%= lead.id %></span>
            </td>
            <td data-label="Contact">
              <strong class="primary-value"><%= lead.name %></strong>
              <a class="contact-link" href="mailto:<%= lead.email %>"><%= lead.email %></a>
              <a class="contact-link" href="tel:<%= lead.phone %>"><%= lead.phone %></a>
            </td>
            <td data-label="Company">
              <span class="secondary-value"><%= lead.company || '—' %></span>
            </td>
            <td data-label="Plan">
              <% if (lead.plan) { %>
                <span class="badge badge--violet"><%= lead.plan %></span>
              <% } else { %>
                <span class="muted-value">Not selected</span>
              <% } %>
            </td>
            <td data-label="Demo">
              <strong class="secondary-value"><%= lead.demo_date || 'Not scheduled' %></strong>
              <% if (lead.demo_time) { %>
                <span class="muted-value"><%= lead.demo_time %></span>
              <% } %>
            </td>
            <td data-label="Details" class="details-cell">
              <details class="row-details">
                <summary>View details</summary>
                <div class="details-popover">
                  <dl class="detail-grid">
                    <div>
                      <dt>Page</dt>
                      <dd><%= lead.page_name || '—' %></dd>
                    </div>
                    <div>
                      <dt>Form</dt>
                      <dd><%= lead.form_name || '—' %></dd>
                    </div>
                    <div class="detail-grid__wide">
                      <dt>Ad source</dt>
                      <dd class="text-break"><%= lead.source || '—' %></dd>
                    </div>
                    <div>
                      <dt>UTM source</dt>
                      <dd><%= lead.utm_source || '—' %></dd>
                    </div>
                    <div>
                      <dt>UTM medium</dt>
                      <dd><%= lead.utm_medium || '—' %></dd>
                    </div>
                    <div>
                      <dt>UTM campaign</dt>
                      <dd><%= lead.utm_campaign || '—' %></dd>
                    </div>
                    <div>
                      <dt>UTM term</dt>
                      <dd><%= lead.utm_term || '—' %></dd>
                    </div>
                    <div>
                      <dt>UTM content</dt>
                      <dd><%= lead.utm_content || '—' %></dd>
                    </div>
                    <div>
                      <dt>Facebook click ID</dt>
                      <dd><%= lead.fbclid || '—' %></dd>
                    </div>
                    <div class="detail-grid__wide">
                      <dt>Google click ID</dt>
                      <dd><%= lead.gclid || '—' %></dd>
                    </div>
                  </dl>
                </div>
              </details>
            </td>
          </tr>
        <% } %>
      </tbody>
    </table>
  </div>

  <%- include('partials/pagination', { pagination }) %>
</section>

<%- include('partials/footer') %>
